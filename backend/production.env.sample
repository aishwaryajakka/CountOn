# Credential-free checklist, not a ready-to-run dotenv file.
# Inject private values through trusted API/MCP/worker runtime configuration.

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=131072
AGENT_EXECUTION_TIMEOUT_SECONDS=45
# OPERATIONS_METRICS_TOKEN=<private-random-token-at-least-43-characters>

# Database (inspect live migration revision before applying Alembic changes)
DATABASE_TARGET=supabase
# SUPABASE_DATABASE_URL=<private-postgresql+psycopg-connection-with-TLS>

# Supabase Auth (same project as browser sign-in)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<public-project-publishable-key>
# No admin secret is needed by ordinary API JWT verification.

# AWS / Bedrock — use a secure SDK runtime credential provider, never public vars.
BEDROCK_ENABLED=false
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.1
BEDROCK_REQUEST_TIMEOUT_SECONDS=30
BEDROCK_OPERATION_TIMEOUT_SECONDS=45
BEDROCK_MAX_RETRIES=2

# Conversation state (private keys shared consistently by the relevant replicas)
CONVERSATION_STORE_BACKEND=postgres
# CONVERSATION_ENCRYPTION_KEY=<base64url-encoding-of-32-random-bytes>
# COUNTON_CLARIFICATION_SIGNING_KEY=<strong-private-shared-secret>

# OAuth / ASK (optional; configure registered client before enabling the Skill)
OAUTH_ALLOWED_CLIENT_IDS=[]
ALEXA_REQUIRE_CONFIRMATION=true
# ALEXA_SKILL_ID=amzn1.ask.skill.<your-skill-id>
# ALEXA_OAUTH_CLIENT_ID=<registered-Supabase-OAuth-client-id>
# Set OAUTH_ALLOWED_CLIENT_IDS=["<same-registered-client-id>"].
# Provider secrets/encryption are in providers.env.sample; supply privately.

# CORS / MCP transport
# ALLOWED_ORIGINS=["https://<frontend-host>"]
# MCP_PUBLIC_URL=https://<mcp-host>/mcp
MCP_ALLOWED_ORIGINS=[]
# Configure exact allowed browser origins when needed; no wildcard or trailing slash.

# Rate limits (per process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WRITES=100
RATE_LIMIT_WINDOW_SECONDS=60

# Optional workers / Notifications
# See monitoring.env.sample, providers.env.sample and notifications.env.sample.
# Enable and supervise workers separately; feature flags do not grant source access.
