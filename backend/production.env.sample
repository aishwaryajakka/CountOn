# Credential-free guide, not a dotenv loader. Set on trusted API/MCP/worker services.
ENVIRONMENT=production
DATABASE_TARGET=supabase
# SUPABASE_DATABASE_URL must be injected privately (postgresql+psycopg, TLS required).
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / ALLOWED_ORIGINS: actual project and frontend.
# ALLOWED_ORIGINS is a JSON array of exact HTTPS origins, no trailing slash.
CONVERSATION_STORE_BACKEND=postgres
# CONVERSATION_ENCRYPTION_KEY: privately generated base64url 32-byte AES key, all API replicas.
# COUNTON_CLARIFICATION_SIGNING_KEY: strong private secret shared by API and MCP.
OAUTH_ALLOWED_CLIENT_IDS=[]
# Set to ["actual-Supabase-Alexa-OAuth-client-id"] before enabling Alexa.
ALEXA_REQUIRE_CONFIRMATION=true
# ALEXA_SKILL_ID / ALEXA_OAUTH_CLIENT_ID: actual console IDs, paired with allowlist.
# MCP_PUBLIC_URL: exact deployed HTTPS endpoint ending /mcp, required by production MCP.
MCP_ALLOWED_ORIGINS=[]
BEDROCK_ENABLED=false
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.1
BEDROCK_REQUEST_TIMEOUT_SECONDS=30
BEDROCK_OPERATION_TIMEOUT_SECONDS=45
BEDROCK_MAX_RETRIES=2
AGENT_EXECUTION_TIMEOUT_SECONDS=45
MAX_REQUEST_BYTES=131072
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WRITES=100
RATE_LIMIT_WINDOW_SECONDS=60
# OPERATIONS_METRICS_TOKEN: privately generated >=43-character random token.
# AWS credentials: secure workload provider chain only; never public frontend vars.
# See monitoring.env.sample for worker and Graph settings.
