# Trusted backend only: merge into backend/.env.local or deployment variables.
# AWS / Bedrock — credentials use the runtime SDK provider chain, never this file.
BEDROCK_ENABLED=false
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.1
BEDROCK_REQUEST_TIMEOUT_SECONDS=30
BEDROCK_OPERATION_TIMEOUT_SECONDS=45
BEDROCK_MAX_RETRIES=2
BEDROCK_MAX_CONCURRENT_CALLS=4
BEDROCK_MAX_TOTAL_TOKENS=8192

# Optional task-specific model overrides; otherwise use BEDROCK_MODEL_ID.
# Verify model access, schema support and grounded quality before changing them.
# BEDROCK_COMPILER_MODEL_ID=<approved-Converse-model-or-inference-profile>
# BEDROCK_INVESTIGATOR_MODEL_ID=<approved-Converse-model-or-inference-profile>
# BEDROCK_NATIVE_STRUCTURED_OUTPUT=false

# Compile/clarify/investigate only: source planning, normalization and evaluation
# are deterministic. Limits are per process, not cluster-wide. The total-token
# budget stops later attempts after reported usage; it cannot guarantee an exact
# billed-cost ceiling or cancel an in-flight SDK request. See docs/bedrock.md.
