# Merge into backend/.env.local or the trusted backend/worker service environment.
# Provider OAuth is separate from existing Supabase user login. Never use NEXT_PUBLIC_*.
GOOGLE_INTEGRATIONS_ENABLED=false
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=common
PROVIDER_SYNC_ENABLED=false
PROVIDER_SYNC_INTERVAL_SECONDS=900
PROVIDER_RETENTION_DAYS=30
# Set secrets securely; all API and provider workers need the SAME encryption key.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=<base64url encoding of 32 random bytes>
# GOOGLE_CLIENT_ID=<OAuth web application client id>
# GOOGLE_CLIENT_SECRET=<secret-store value>
# GOOGLE_REDIRECT_URI=https://<API_HOST>/api/v1/integrations/oauth/google/callback
# MICROSOFT_CLIENT_ID=<Entra application UUID>
# MICROSOFT_CLIENT_SECRET=<secret-store value>
# MICROSOFT_REDIRECT_URI=https://<API_HOST>/api/v1/integrations/oauth/microsoft/callback
# Optional push; polling works without it. Use a public HTTPS base, no query/token:
# PROVIDER_WEBHOOK_URL=https://<API_HOST>/api/v1/integrations/webhooks
# Gmail push needs an existing Pub/Sub topic and authenticated push subscription:
# GMAIL_PUBSUB_TOPIC=projects/<GOOGLE_PROJECT>/topics/<TOPIC>
# GMAIL_PUBSUB_AUDIENCE=https://<API_HOST>/api/v1/integrations/webhooks/gmail
# GMAIL_PUBSUB_SERVICE_ACCOUNT=<PUSH_IDENTITY>@<PROJECT>.iam.gserviceaccount.com

# Source planning requires enabled accounts, read scopes, a usable local OAuth grant
# and a recent successful synchronization. Preview/confirm does not grant permissions.
# Enable provider sync on its separately supervised existing worker, after consent.
# Normalization caching is process-local: 256 entries, 900s TTL, owner/generation/scoped.
