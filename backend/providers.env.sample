# Trusted backend/worker only: merge into backend/.env.local or service variables.
# Provider OAuth is separate from Supabase user login. Never use NEXT_PUBLIC_*.

# Application / source synchronization (optional; disabled by default)
PROVIDER_SYNC_ENABLED=false
PROVIDER_SYNC_INTERVAL_SECONDS=900
PROVIDER_RETENTION_DAYS=30

# OAuth / Google and Microsoft
GOOGLE_INTEGRATIONS_ENABLED=false
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=common
# All API/provider workers need the SAME privately supplied encryption key.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=<base64url-encoding-of-32-random-bytes>
# GOOGLE_CLIENT_ID=<OAuth-web-application-client-id>
# GOOGLE_CLIENT_SECRET=<backend-secret-store-value>
# GOOGLE_REDIRECT_URI=https://<api-host>/api/v1/integrations/oauth/google/callback
# MICROSOFT_CLIENT_ID=<Entra-application-UUID>
# MICROSOFT_CLIENT_SECRET=<backend-secret-store-value>
# MICROSOFT_REDIRECT_URI=https://<api-host>/api/v1/integrations/oauth/microsoft/callback

# Optional provider push; polling works without it. No query strings or tokens.
# PROVIDER_WEBHOOK_URL=https://<api-host>/api/v1/integrations/webhooks
# Gmail additionally needs an existing Pub/Sub topic and authenticated push setup.
# GMAIL_PUBSUB_TOPIC=projects/<google-project>/topics/<topic>
# GMAIL_PUBSUB_AUDIENCE=https://<api-host>/api/v1/integrations/webhooks/gmail
# GMAIL_PUBSUB_SERVICE_ACCOUNT=<push-identity>@<project>.iam.gserviceaccount.com

# Source planning requires enabled accounts, read scopes, a usable local OAuth
# grant and recent successful synchronization. Preview/confirm grants no new
# permissions. Enable the separately supervised provider worker after consent.
# Normalization cache: process-local, 256 entries, 900s TTL, owner/generation/scoped.
