# Trusted backend/worker only: merge into backend/.env.local or service variables.
# Notifications / optional email outbox; in-app notifications need no email service.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=resend
# NOTIFICATION_EMAIL_API_KEY=<sending-only-Resend-key>
# NOTIFICATION_EMAIL_FROM=<verified-sender-address>
# FRONTEND_PUBLIC_URL=https://<frontend-host>
# INTEGRATION_TOKEN_ENCRYPTION_KEY=<base64url-encoding-of-32-random-bytes>
# The shared private integration key encrypts confirmed recipients/frozen outbox data.

# Optional SMTP instead of Resend: set NOTIFICATION_EMAIL_PROVIDER=smtp explicitly.
# SMTP_HOST=<smtp-provider-host>
# SMTP_PORT=587
# SMTP_USERNAME=<backend-secret-store-value>
# SMTP_PASSWORD=<backend-secret-store-value>
# SMTP_FROM_EMAIL=<verified-sender-address>
# SMTP_USE_TLS=true
# SMTP requires TLS and bounded connections. Failed/uncertain sends are not
# automatically retried: SMTP lacks provider idempotency. Review failed deliveries.
