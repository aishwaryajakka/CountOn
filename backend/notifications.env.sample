# Merge non-secret options into backend/.env.local; keep secrets in runtime configuration.
NOTIFICATION_EMAIL_ENABLED=false
# Optional Resend sending-only API key and a verified-domain sender, never NEXT_PUBLIC_*.
# NOTIFICATION_EMAIL_API_KEY=
# NOTIFICATION_EMAIL_FROM=
# FRONTEND_PUBLIC_URL=https://your-counton-frontend.example
# Existing INTEGRATION_TOKEN_ENCRYPTION_KEY encrypts confirmed recipients and frozen outbox payloads.

# Default transport remains Resend. Optional SMTP uses the SAME confirmed-recipient outbox.
NOTIFICATION_EMAIL_PROVIDER=resend
# For explicit SMTP opt-in, set provider=smtp and supply these securely at runtime:
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=notifications@your-domain.example
# SMTP_USE_TLS=true
# SMTP requires TLS and bounded connections. Failed/uncertain sends are not automatically
# retried: SMTP has no provider idempotency key. Review failed deliveries before manual action.
