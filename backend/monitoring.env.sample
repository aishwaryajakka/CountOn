# Merge these non-secret settings into backend/.env.local or backend service env.
# API and worker must use the same existing DATABASE_TARGET/database configuration.
MONITORING_ENABLED=false
MONITORING_POLL_SECONDS=5
MONITORING_LEASE_SECONDS=300
MONITORING_BACKOFF_SECONDS=30
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=common
# Set these securely before enabling Graph (no real credentials in this template):
# MICROSOFT_CLIENT_ID=<Entra application UUID>
# MICROSOFT_CLIENT_SECRET=<backend secret-store value>
# MICROSOFT_REDIRECT_URI=https://<API_HOST>/api/v1/integrations/oauth/microsoft/callback
# INTEGRATION_TOKEN_ENCRYPTION_KEY=<URL-safe base64 encoding of 32 random bytes>
