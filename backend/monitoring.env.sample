# Trusted backend/worker only: merge into backend/.env.local or service variables.
# Application / monitoring (same DATABASE_TARGET and database as the API)
MONITORING_ENABLED=false
MONITORING_POLL_SECONDS=5
MONITORING_LEASE_SECONDS=300
MONITORING_BACKOFF_SECONDS=30

# OAuth / optional Microsoft source; users must authorize and approve bindings.
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_TENANT_ID=common
# MICROSOFT_CLIENT_ID=<Entra-application-UUID>
# MICROSOFT_CLIENT_SECRET=<backend-secret-store-value>
# MICROSOFT_REDIRECT_URI=https://<api-host>/api/v1/integrations/oauth/microsoft/callback
# INTEGRATION_TOKEN_ENCRYPTION_KEY=<base64url-encoding-of-32-random-bytes>
# See providers.env.sample for Google/Microsoft synchronization settings.
