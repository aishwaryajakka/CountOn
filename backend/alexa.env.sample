# Trusted backend only: merge into backend/.env.local or deployment variables.
# OAuth / ASK (optional; endpoint stays disabled until a real Skill ID is set)
# ALEXA_SKILL_ID=amzn1.ask.skill.<your-skill-id>
# ALEXA_OAUTH_CLIENT_ID=<registered-Supabase-OAuth-client-id>
# OAUTH_ALLOWED_CLIENT_IDS=["<same-registered-client-id>"]
ALEXA_REQUIRE_CONFIRMATION=true

# Conversation state / MCP (configure privately and consistently on API and MCP)
# MCP_PUBLIC_URL=https://<mcp-host>/mcp
# COUNTON_CLARIFICATION_SIGNING_KEY=<strong-private-shared-secret>
# Production also requires CONVERSATION_STORE_BACKEND=postgres and a private
# CONVERSATION_ENCRYPTION_KEY. See production.env.sample and docs/traditional-alexa.md.
# Never put linked bearer tokens or AWS credentials in a tracked template.
