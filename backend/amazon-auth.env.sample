# Trusted backend only: merge into backend/.env.local or deployment variables.
# OAuth / optional Login with Amazon UserInfo translator
AMAZON_AUTH_ENABLED=false
# AMAZON_CLIENT_ID=<Login-with-Amazon-Security-Profile-client-id>
# LWA_CLIENT_SECRET belongs in Supabase custom-provider configuration, not here.
# This endpoint does not issue CountOn sessions. Enable only with a verified
# compatible Supabase provider configuration; see docs/authentication.md.
