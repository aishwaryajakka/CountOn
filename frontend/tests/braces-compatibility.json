[
  {
    "pattern": "app/{api,ui}/**/*.{ts,tsx}",
    "compile": "app/(api|ui)/**/*.(ts|tsx)",
    "expand": [
      "app/api/**/*.ts",
      "app/api/**/*.tsx",
      "app/ui/**/*.ts",
      "app/ui/**/*.tsx"
    ],
    "stringify": "app/{api,ui}/**/*.{ts,tsx}"
  },
  {
    "pattern": "src/{a,{b,c}}.js",
    "compile": "src/(a|(b|c)).js",
    "expand": [
      "src/a.js",
      "src/b.js",
      "src/c.js"
    ],
    "stringify": "src/{a,{b,c}}.js"
  },
  {
    "pattern": "file-{01..03}.txt",
    "compile": "file-(0[1-3]).txt",
    "expand": [
      "file-01.txt",
      "file-02.txt",
      "file-03.txt"
    ],
    "stringify": "file-{01..03}.txt"
  },
  {
    "pattern": "x/{a,b}/y/{1,2}",
    "compile": "x/(a|b)/y/(1|2)",
    "expand": [
      "x/a/y/1",
      "x/a/y/2",
      "x/b/y/1",
      "x/b/y/2"
    ],
    "stringify": "x/{a,b}/y/{1,2}"
  },
  {
    "pattern": "{foo,bar}",
    "compile": "(foo|bar)",
    "expand": [
      "foo",
      "bar"
    ],
    "stringify": "{foo,bar}"
  },
  {
    "pattern": "literal\\{brace\\}",
    "compile": "literal{brace}",
    "expand": [
      "literal{brace}"
    ],
    "stringify": "literal{brace}"
  },
  {
    "pattern": "a/{}/z",
    "compile": "a/{}/z",
    "expand": [
      "a/{}/z"
    ],
    "stringify": "a/{}/z"
  },
  {
    "pattern": "${literal}",
    "compile": "${literal}",
    "expand": [
      "${literal}"
    ],
    "stringify": "${literal}"
  },
  {
    "pattern": "x/{a,b",
    "compile": "x/{a,b",
    "expand": [
      "x/{a,b"
    ],
    "stringify": "x/{a,b"
  },
  {
    "pattern": "(a(b(c)))",
    "compile": "(a(b(c)))",
    "expand": [
      "(a(b(c)))"
    ],
    "stringify": "(a(b(c)))"
  }
]
