# Application / public browser values; replace placeholders before real sign-in.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production requires actual remote HTTPS API/frontend origins and a rebuild.

# Supabase Auth / public values from the same project as the trusted backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key

# OAuth / optional Amazon; enable only after compatible custom:amazon live acceptance.
NEXT_PUBLIC_AMAZON_AUTH_ENABLED=false
# Optional ASK OAuth consent: exact registered public client ID and console callbacks.
# NEXT_PUBLIC_ALEXA_OAUTH_CLIENT_ID=<registered-Supabase-OAuth-client-id>
# NEXT_PUBLIC_ALEXA_REDIRECT_URIS=https://<approved-Alexa-callback>

# Optional server-only MCP discovery destination; never prefix with NEXT_PUBLIC_.
# COUNTON_MCP_URL=http://127.0.0.1:8003/mcp
# Conversation actions use backend MCP_PUBLIC_URL through the shared orchestrator.
# No AWS, database, provider secret, service-role or private token belongs here.
